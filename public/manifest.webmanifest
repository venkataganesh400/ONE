{
  "id": "one-workspace-app",
  "name": "One Workspace",
  "short_name": "One",
  "description": "Minimal, offline-first student personal workspace and alignment engine.",
  "theme_color": "#1C1917",
  "background_color": "#F9F7F2",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "start_url": "./index.html",
  "scope": "./",
  "icons": [
    {
      "src": "./pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
